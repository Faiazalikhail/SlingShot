# Copy this file to .env and fill in real values before running docker compose up

# ── MySQL ──────────────────────────────────────────────────────────────────────
DB_NAME=hawkvision
DB_USER=hawkvision
DB_PASS=secret
DB_ROOT_PASS=rootsecret

# ── JWT (PHP auth) ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_real_secret

# ── S3 / DigitalOcean Spaces ───────────────────────────────────────────────────
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key
# For DigitalOcean Spaces, also set the endpoint in php-app/src/Upload/UploadController.php:
#   'endpoint' => 'https://<region>.digitaloceanspaces.com'
